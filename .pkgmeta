# BigWigs Packager: what goes into the CurseForge zip
package-as: CraftPath

ignore:
  - tools
  - releases
  - media
  - CURSEFORGE.md
  - .gitignore
  - .pkgmeta
  - .gitattributes

# CurseForge changelog: the top section of CHANGELOG.md
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
